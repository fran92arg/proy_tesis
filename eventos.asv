function signal=eventos(EEG)
%function EEG=prueba1(EEG)
ventana=1024;
Ncols=length(EEG.times)/ventana;
matriz=zeros(ventana,Ncols);
matriz=reshape(EEG.data(5,:),ventana,Ncols);
Fs=EEG.srate;
size(matriz)
Y=fft(matriz);
f=Fs/ventana*(0:ventana/2);
N     = size(EEG.data, 2);
t     = (0:N-1) / EEG.srate;            % eje de tiempo en segundos

% Eventos (sin boundary)
tipos = {EEG.event.type};
keep  = ~strcmp(tipos, 'boundary');
idx   = round([EEG.event(keep).latency]);
tipos = tipos(keep);

% Códigos numéricos (si los tipos son texto, se mapean a 1..K)
cod = cellfun(@(x) double(str2double(string(x))), tipos);
if any(isnan(cod))
    cod = grp2idx(tipos)';
end

% Señal de eventos
sig = zeros(1, N);
sig(idx) = cod;
end