% function signal=eventos(EEG)
N     = size(EEG.data, 2);
% t     = (0:N-1) / EEG.srate;            % eje de tiempo en segundos
t=EEG.times;

% Eventos (sin boundary)
tipos = {EEG.event.type};
keep  = ~strcmp(tipos, 'boundary');
idx   = round([EEG.event(keep).latency]);
tipos = tipos(keep);

% Códigos numéricos (si los tipos son texto, se mapean a 1..K)
cod = cellfun(@(x) double(str2double(string(x))), tipos);
if any(isnan(cod))
    cod = grp2idx(tipos)';
end

% Señal de eventos
sig = zeros(1, N);
sig(idx) = cod;

% Gráfico
figure;
plot(t, sig, 'k');
xlabel('Tiempo (s)');
ylabel('Código de evento');
title('Señal de eventos');
grid on;
%% end
cant=0;
for i=1:length(EEG.times)
    if(sig(i)>2000)
        cant=cant+1;
    end
end
cant